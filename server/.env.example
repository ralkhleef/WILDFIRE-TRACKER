# Local server settings
PORT=5050
NODE_ENV=development

# Local PostgreSQL example for Prisma
DATABASE_URL="postgresql://USERNAME@localhost:5432/wildfire_tracker?schema=public"

# JWT authentication settings
JWT_SECRET=make_this_any_long_random_text
JWT_EXPIRES_IN=7d

# Google OAuth placeholder settings
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5050/api/auth/google/callback

# External wildfire data sources
CALFIRE_API_URL=https://www.fire.ca.gov/umbraco/api/IncidentApi/List?inactive=false
NASA_FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key
NASA_FIRMS_SOURCE=VIIRS_SNPP_NRT
NASA_FIRMS_AREA=-125,32,-113,42
NASA_FIRMS_DAY_RANGE=1

# Default geolocation alert radius in miles
DEFAULT_ALERT_RADIUS_MILES=25
