# ---------------------------------------------------------------------------
# WildFire-Tracker frontend environment template.
# Copy this file to client/.env and fill in the values. NEVER commit real keys.
# Only VITE_* variables are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Base URL for backend API calls.
VITE_API_URL=http://localhost:5050

# Public Google Maps JavaScript API key (used for client-side map rendering).
# Restrict this key to your domain in the Google Cloud Console.
# Server-side Google APIs (Geocoding, Places, Air Quality, Routes) live in the
# backend env, never here.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: enables MapTiler Streets as the Standard map style.
# Leave blank to use OpenFreeMap Positron/Liberty without an API key.
VITE_MAPTILER_KEY=
